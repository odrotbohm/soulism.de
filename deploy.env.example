# Kopieren nach deploy.env und ausfüllen. deploy.env wird nicht veröffentlicht.
SFTP_HOST="sftp.example.com"
SFTP_PORT="22"
SFTP_USER="benutzer"
# Optional: Zielverzeichnis auf dem Server, relativ zum Login-Verzeichnis.
# Leer lassen, wenn der Login schon im Webverzeichnis landet. Muss existieren.
# ACHTUNG: Dateien dort, die nicht in _site liegen, werden beim Deploy gelöscht.
SFTP_PATH=""
# Optional. Leer lassen, um per SSH-Key anzumelden (empfohlen).
SFTP_PASSWORD=""
